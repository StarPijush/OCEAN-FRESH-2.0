{
  "name": "@oceanfresh/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, validators, and utilities for OceanFresh",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors/index.ts",
    "./types": "./src/types/index.ts",
    "./validators": "./src/validators/index.ts",
    "./logger": "./src/logger/index.ts",
    "./config": "./src/config/index.ts",
    "./features": "./src/features/index.ts",
    "./di": "./src/di/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
