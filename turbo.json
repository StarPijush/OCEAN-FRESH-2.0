{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_SUPABASE_STORAGE_BUCKET",
    "VITE_ENVIRONMENT",
    "VITE_APP_URL",
    "VITE_SENTRY_DSN",
    "VITE_APP_CHECK_SITE_KEY",
    "VITE_FEATURE_COUPONS",
    "VITE_FEATURE_REVIEWS",
    "VITE_FEATURE_PAYMENTS",
    "VITE_FEATURE_INVENTORY",
    "VITE_FEATURE_ANALYTICS",
    "VITE_MAINTENANCE_MODE",
    "NODE_ENV"
  ],
  "globalDependencies": ["tsconfig.json", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "NODE_ENV",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_ANON_KEY",
        "VITE_SUPABASE_STORAGE_BUCKET",
        "VITE_ENVIRONMENT",
        "VITE_APP_URL",
        "VITE_SENTRY_DSN",
        "VITE_APP_CHECK_SITE_KEY",
        "VITE_FEATURE_COUPONS",
        "VITE_FEATURE_REVIEWS",
        "VITE_FEATURE_PAYMENTS",
        "VITE_FEATURE_INVENTORY",
        "VITE_FEATURE_ANALYTICS",
        "VITE_MAINTENANCE_MODE"
      ]
    },
    "build:analyze": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "stats.html"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {},
    "test": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {},
    "clean": {
      "cache": false
    },
    "preview": {
      "dependsOn": ["build"]
    }
  }
}
