{
  "name": "@oceanfresh/functions",
  "version": "0.0.0",
  "private": true,
  "description": "OceanFresh Firebase Cloud Functions",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
