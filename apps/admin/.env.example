# OceanFresh Admin (React + Vite) — public environment variables.
# Prefix `VITE_` is required for values to be inlined by Vite.
# Copy to .env and fill in real values (or rely on CI secrets / root env files).
# Note: vite.config.ts sets envDir to the monorepo root, so the app also picks
# up root-level .env*, .env.development, .env.production files.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_STORAGE_BUCKET=products

# Storefront site opened by the "View Store" action.
VITE_STOREFRONT_URL=http://localhost:3000