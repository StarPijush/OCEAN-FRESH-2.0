# OceanFresh Admin (React Native / Expo) — public environment variables.
# Prefix `EXPO_PUBLIC_` is required for values to be inlined by Metro.
# Copy to .env and fill in real values (or rely on CI secrets).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=products

# Storefront site opened by the "View Store" action.
EXPO_PUBLIC_STOREFRONT_URL=https://localhost:3000