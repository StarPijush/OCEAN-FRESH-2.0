{
  "expo": {
    "name": "OceanFresh Admin",
    "slug": "oceanfresh-admin",
    "scheme": "oceanfresh-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0f12",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0f12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.oceanfresh.admin"
    },
    "android": {
      "package": "in.oceanfresh.admin",
      "adaptiveIcon": {
        "backgroundColor": "#0d0f12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OceanFresh Admin to select product photos."
        }
      ]
    ]
  }
}
